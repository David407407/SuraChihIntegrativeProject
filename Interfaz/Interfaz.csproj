<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Interfaz de SuraChih en Blazor (componentes .razor, estilos y recursos de wwwroot).
    La usa la app de escritorio (SuraChihIntegrativeProject: WPF + BlazorWebView).
    Los archivos de wwwroot se sirven como _content/Interfaz/... (ver Utilidades/Recursos.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Interfaz</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackendLogica\BackendLogica.csproj" />
  </ItemGroup>

</Project>
