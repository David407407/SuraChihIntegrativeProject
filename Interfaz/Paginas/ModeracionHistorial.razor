@*
  "Moderación / Historial" de Figma: cada aprobación o rechazo (tabla moderation) con fecha, comentario y moderador.
  Las píldoras Todo / Aprobados / Rechazados filtran en la BD. "Reseñas moderadas" (tabla review_moderation), con la
  misma tabla y "Volver a mostrar": un supermoderador ve todo y un moderador solo lo suyo; lo decide BackendLogica.
*@
@page "/moderacion/historial"
@implements IDisposable
@inject Sesion Sesion
@inject ServicioModeracion Servicio
@inject Modales Modales
@inject Avisos Avisos
@inject Acciones Acciones
@inject ILogger<ModeracionHistorial> Registro

<PageTitle>SuraChih · Historial de decisiones</PageTitle>

<div class="pagina-fondo">
    <main class="historial contenedor">
        <EncabezadoModeracion Titulo="Historial de decisiones" Usuario="Sesion.Usuario"
                              Texto="@(_filtro == Filtro.Resenas
                                  ? "Cada reseña ocultada o vuelta a mostrar queda registrada con fecha y moderador."
                                  : "Cada aprobación o rechazo queda registrado con fecha, comentario y moderador.")" />

        <AccesoModeracion>
            <PestanasModeracion Activa="PestanasModeracion.Seccion.Historial" Publicaciones="_conteos?.Publicaciones"
                                Organizadores="_conteos?.Organizadores" Reportes="_conteos?.Reportes" />

            <div class="historial__pildoras" role="group" aria-label="Qué decisiones mostrar">
                <Pildora Texto="Todo" Activa="_filtro == Filtro.Todo" OnClick="() => ElegirAsync(Filtro.Todo)" />
                <Pildora Texto="Aprobados" Activa="_filtro == Filtro.Aprobados" OnClick="() => ElegirAsync(Filtro.Aprobados)" />
                <Pildora Texto="Rechazados" Activa="_filtro == Filtro.Rechazados" OnClick="() => ElegirAsync(Filtro.Rechazados)" />
                <Pildora Texto="@TextoResenas" Activa="_filtro == Filtro.Resenas" OnClick="() => ElegirAsync(Filtro.Resenas)" />
            </div>

            <p class="solo-lectores" role="status">@Anuncio</p>

            @if (_error)
            {
                <VacioModeracion Icono="alerta-error" Titulo="No se pudo cargar el historial" Texto="Revisa tu conexión e inténtalo otra vez.">
                    <Boton Texto="Reintentar" Variante="oscuro" OnClick="ReintentarAsync" />
                </VacioModeracion>
            }
            else if (_filas == null)
            {
                <div class="esqueleto historial__esqueleto" aria-hidden="true"></div>
            }
            else if (_filas.Count == 0)
            {
                <VacioModeracion Icono="bandeja" Titulo="Nada por aquí" Texto="Aún no hay decisiones registradas con este filtro." />
            }
            else
            {
                <div class="historial__tabla">
                    @* Los role mantienen la tabla para los lectores de pantalla cuando en pantallas angostas se apila. *@
                    <div class="historial__desplazar">
                        <table role="table">
                            <caption class="solo-lectores">Historial de decisiones de moderación</caption>
                            <thead class="t-caption texto-2" role="rowgroup">
                                <tr role="row">
                                    <th scope="col" role="columnheader" class="historial__fecha">FECHA</th>
                                    <th scope="col" role="columnheader">OBJETIVO</th>
                                    <th scope="col" role="columnheader" class="historial__tipo">TIPO</th>
                                    <th scope="col" role="columnheader" class="historial__decision">DECISIÓN</th>
                                    <th scope="col" role="columnheader" class="historial__comentario">@(_filtro == Filtro.Resenas ? "RESEÑA" : "COMENTARIO")</th>
                                    <th scope="col" role="columnheader" class="historial__moderador">MODERADOR</th>
                                </tr>
                            </thead>
                            <tbody role="rowgroup">
                                @foreach (var f in _filas)
                                {
                                    <tr role="row">
                                        <td role="cell" class="t-small texto-2 historial__fecha">@Fecha(f.Fecha)</td>
                                        <td role="cell" class="t-body-fuerte historial__objetivo">@f.Objetivo</td>
                                        <td role="cell" class="t-small historial__tipo">@f.Tipo</td>
                                        <td role="cell" class="historial__decision"><Chip Texto="@f.Decision" Variante="@(f.Positiva ? "exito-suave" : "error-suave")" Icono="@(f.Positiva ? "check-circulo-exito-12" : "x-circulo-error-12")" Clase="chip--estado" /></td>
                                        <td role="cell" class="t-small historial__comentario @(f.Comentario == null ? "historial__comentario--vacio" : "")">
                                            <span>@(f.Comentario ?? "—")</span>
                                            @if (f.Resena is { } oculta && SigueOculta(oculta))
                                            {
                                                <Boton Texto="Volver a mostrar" Variante="secundario" Tamano="s" Icono="ojo-tinta-16" Clase="historial__mostrar" Deshabilitado="_ocupado"
                                                       OnClick="() => MostrarAsync(oculta)" aria-label="@($"Volver a mostrar: {f.Objetivo}")" />
                                            }
                                        </td>
                                        <td role="cell" class="t-small texto-2 historial__moderador">@f.Moderador</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="historial__pie">
                        <p class="t-small texto-2">Mostrando @_filas.Count de @_total</p>
                        @if (_filas.Count < _total)
                        {
                            <Boton Texto="Ver más" Variante="secundario" Tamano="s" Ocupado="_cargandoMas" OnClick="VerMasAsync" />
                        }
                    </div>
                </div>
            }
        </AccesoModeracion>
    </main>
</div>

<VolverArriba />

@code {
    private enum Filtro { Todo, Aprobados, Rechazados, Resenas }

    /// <summary>Una fila de la tabla, venga de moderation o de review_moderation.</summary>
    private sealed record Fila(DateTime Fecha, string Objetivo, string Tipo, string Decision, bool Positiva, string? Comentario, string Moderador, RegistroResena? Resena = null);

    private Filtro _filtro = Filtro.Todo;
    private IReadOnlyList<Fila>? _filas;
    private int _total;
    private int _limite = ServicioModeracion.FilasHistorial;
    private ConteosModeracion? _conteos;
    private bool _error;
    private bool _cargandoMas;
    private bool _ocupado;
    /// <summary>Lo más reciente que se hizo con cada reseña: "Volver a mostrar" solo sale si sigue oculta.</summary>
    private HashSet<int> _ocultasVigentes = [];
    private int? _usuarioId;

    private bool EsModerador => Sesion.Usuario?.EsModerador == true;

    private string Anuncio => _error ? "No se pudo cargar el historial." : _filas == null ? "" : $"{NombreFiltro}: mostrando {_filas.Count} de {_total}.";

    private string NombreFiltro => _filtro switch
    {
        Filtro.Aprobados => "Aprobados",
        Filtro.Rechazados => "Rechazados",
        Filtro.Resenas => TextoResenas,
        _ => "Todo",
    };

    private bool EsSuperModerador => Sesion.Usuario?.EsSuperModerador == true;
    private string TextoResenas => EsSuperModerador ? "Reseñas moderadas" : "Mis reseñas moderadas";

    private bool SigueOculta(RegistroResena r) => _ocultasVigentes.Contains(r.Id);

    /// <summary>"9 oct, 11:05"; con el año si no es este.</summary>
    private static string Fecha(DateTime fecha) =>
        fecha.Year == DateTime.Today.Year ? $"{Formato.RangoFechas(fecha)}, {fecha:HH:mm}" : $"{Formato.RangoFechas(fecha)} {fecha.Year}, {fecha:HH:mm}";

    protected override async Task OnInitializedAsync()
    {
        Sesion.Cambio += AlCambiarSesion;
        _usuarioId = Sesion.Usuario?.Id;
        if (!Sesion.Iniciada) Modales.RequiereSesion("Inicia sesión con tu cuenta de moderador para ver el historial.");
        else if (EsModerador) await CargarAsync();
    }

    private async Task ElegirAsync(Filtro filtro)
    {
        if (_filtro == filtro) return;
        _filtro = filtro;
        _filas = null;
        _limite = ServicioModeracion.FilasHistorial;
        await CargarAsync();
    }

    private async Task ReintentarAsync()
    {
        _filas = null;
        await CargarAsync();
    }

    private async Task VerMasAsync()
    {
        _cargandoMas = true;
        _limite += ServicioModeracion.FilasHistorial;
        await CargarAsync();
        _cargandoMas = false;
    }

    private async Task MostrarAsync(RegistroResena r)
    {
        if (_ocupado) return;
        _ocupado = true;
        try
        {
            bool cambio = await Servicio.MostrarResenaAsync(r.Tipo, r.ResenaId);
            Avisos.Mostrar(cambio ? "La reseña volvió a mostrarse." : "Esa reseña ya estaba visible.", cambio ? TipoAviso.Exito : TipoAviso.Info);
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Registro.LogError(ex, "No se pudo volver a mostrar la reseña");
            Avisos.Mostrar(MensajesError.Para(ex), TipoAviso.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task CargarAsync()
    {
        Filtro pedido = _filtro;
        _error = false;
        try
        {
            if (pedido == Filtro.Resenas)
            {
                var datos = await Servicio.ObtenerHistorialResenasAsync(_limite);
                if (pedido != _filtro) return;   // mientras cargaba eligió otra píldora
                _filas = [.. datos.Filas.Select(DeResena)];
                // Filas de la más reciente a la más antigua: la primera de cada reseña es su estado actual.
                _ocultasVigentes = [.. datos.Filas.GroupBy(r => (r.Tipo, r.ResenaId)).Select(g => g.First()).Where(r => r.Accion == AccionResena.Ocultada).Select(r => r.Id)];
                (_total, _conteos) = (datos.Total, datos.Conteos);
            }
            else
            {
                var datos = await Servicio.ObtenerHistorialAsync(pedido switch
                {
                    Filtro.Aprobados => DecisionModeracion.Aprobado,
                    Filtro.Rechazados => DecisionModeracion.Rechazado,
                    _ => null,
                }, _limite);
                if (pedido != _filtro) return;
                _filas = [.. datos.Filas.Select(DeDecision)];
                (_total, _conteos) = (datos.Total, datos.Conteos);
            }
        }
        catch (RequiereSesionException)
        {
            Modales.RequiereSesion();
        }
        catch (Exception ex)
        {
            Registro.LogError(ex, "No se pudo cargar el historial de moderación");
            _error = true;
        }
    }

    private static Fila DeDecision(RegistroModeracion r) => new(
        r.DecididoEn, r.ObjetivoNombre,
        r.Tipo switch
        {
            TipoObjetivoModeracion.Evento => "Evento",
            TipoObjetivoModeracion.Lugar => "Lugar",
            _ => "Organizador",
        },
        r.Decision == DecisionModeracion.Aprobado ? "Aprobado" : "Rechazado",
        r.Decision == DecisionModeracion.Aprobado, r.Comentario, r.ModeradorNombre);

    private static Fila DeResena(RegistroResena r) => new(
        r.DecididoEn, $"Reseña en {r.ObjetivoNombre}",
        r.Tipo == TipoResena.Evento ? "Reseña de evento" : "Reseña de lugar",
        r.Accion == AccionResena.Ocultada ? "Oculta" : "Visible",
        r.Accion == AccionResena.Mostrada,
        r.Comentario == null ? $"Sin comentario, de @{r.AutorNombre}" : $"“{r.Comentario}”, de @{r.AutorNombre}",
        r.ModeradorNombre, r);

    private void AlCambiarSesion() => InvokeAsync(async () =>
    {
        int? id = Sesion.Usuario?.Id;
        if (id == _usuarioId) return;
        if (_usuarioId != null && id == null) { Acciones.IrA(Acciones.Rutas.Home); return; }   // cerró sesión aquí
        _usuarioId = id;
        _filtro = Filtro.Todo;
        _filas = null;
        if (EsModerador) await CargarAsync();
        StateHasChanged();
    });

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}
