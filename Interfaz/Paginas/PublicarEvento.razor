    private void MoverPin((decimal Lat, decimal Lng) punto)
    {
        (_lat, _lng) = punto;
        _errores.Quitar("mapa");
    }

    private void CambiarPrecio(bool dePago)
    {
        _dePago = dePago;
        _errores.Quitar("precioMin");
        _errores.Quitar("precioMax");
    }

    private void HacerPortada(int i)
    {
        string foto = _fotos[i];
        _fotos.RemoveAt(i);
        _fotos.Insert(0, foto);
    }

    private void QuitarFoto(int i) => _fotos.RemoveAt(i);

    /// <summary>Sube a Cloudinary las fotos elegidas (o arrastradas), una por una, hasta llenar las 8.</summary>
    private async Task SubirFotosAsync(InputFileChangeEventArgs e)
    {
        _errores.Quitar("fotos");
        int espacio = ServicioImagenes.MaximoFotos - _fotos.Count;
        var archivos = e.GetMultipleFiles(Math.Max(e.FileCount, 1)).ToList();
        if (archivos.Count > espacio)
            _errores.Poner("fotos", $"Solo caben {ServicioImagenes.MaximoFotos} fotos: se subieron las primeras {espacio}.", enfocar: false);

        var porSubir = archivos.Take(espacio).ToList();
        _subiendo = porSubir.Count;
        foreach (IBrowserFile archivo in porSubir)
        {
            try
            {
                ServicioImagenes.Validar(archivo.ContentType, archivo.Size);
                await using Stream contenido = archivo.OpenReadStream(ServicioImagenes.MaximoBytes);
                string url = await Imagenes.SubirAsync(contenido, archivo.Name, archivo.ContentType);
                if (!_fotos.Contains(url)) _fotos.Add(url);
            }
            catch (Exception ex)
            {
                if (ex is not BackendLogica.Datos.SuraChihException) Registro.LogError(ex, "No se pudo subir la foto {Nombre}", archivo.Name);
                _errores.Poner("fotos", $"{archivo.Name}: {MensajesError.Para(ex)}", enfocar: false);
            }
            finally
            {
                _subiendo--;
                StateHasChanged();
            }
        }
        _subiendo = 0;
    }

    // ---------------------------------------------------------------- Guardar

    /// <summary>Id del evento que se acaba de crear como borrador (al recargarlo se conserva "Borrador guardado").</summary>
    private int? _recienGuardado;

    private async Task GuardarAsync(Guardado como)
    {
        _aviso = null;
        if (Validar() is { } seccion)
        {
            _aviso = "Revisa los campos marcados.";
            await Js.DesplazarAAsync(seccion);
            return;
        }

        DatosEvento datos = Datos();
        _guardando = como;
        try
        {
            if (Id is not { } id)
            {
                int nuevo = await Servicio.CrearAsync(datos, enviarARevision: como == Guardado.Enviar);
                if (como == Guardado.Enviar) await EnviadoAsync(nuevo, datos);
                else BorradorGuardado(nuevo);
                return;
            }

            ResultadoEdicionEvento resultado = await Servicio.ActualizarAsync(id, datos, enviarARevision: como == Guardado.Enviar);
            if (como == Guardado.Enviar || resultado.VolvioARevision)
            {
                await EnviadoAsync(id, datos);
            }
            else if (como == Guardado.Borrador)
            {
                BorradorGuardado(id);
            }
            else
            {
                Avisos.Mostrar("Guardaste los cambios");
                _estado = resultado.Estado;
            }
        }
        catch (RequiereSesionException)
        {
            Modales.RequiereSesion();
        }
        catch (Exception ex)
        {
            if (ex is not BackendLogica.Datos.SuraChihException) Registro.LogError(ex, "No se pudo guardar el evento {Id}", Id);
            _aviso = MensajesError.Para(ex);
        }
        finally
        {
            _guardando = null;
        }
    }

    private void BorradorGuardado(int id)
    {
        _guardadoEn = DateTime.Now;
        _recienGuardado = id;
        _estado = EstadoEvento.Borrador;
        Avisos.Mostrar("Guardaste el borrador");
        // Un borrador nuevo pasa a editarse: así "Guardar borrador" otra vez no crea un segundo evento.
        if (Id != id)
        {
            _cargado = id;   // ya está en pantalla: no se vuelve a pedir
            Nav.NavigateTo(Acciones.Rutas.EditarEvento(id), replace: true);
        }
    }

    /// <summary>"Tu evento está en revisión" y lo que elija: su panel, otro evento nuevo o quedarse a verlo.</summary>
    private async Task EnviadoAsync(int id, DatosEvento datos)
    {
        _estado = EstadoEvento.Pendiente;
        _guardadoEn = null;
        string lugar = LugarPrevio;
        string detalle = $"{Formato.RangoFechas(datos.Inicio, datos.Fin)} · {lugar}";
        string? eleccion = await Modales.EnviadoARevisionAsync(datos.Titulo.Trim(), datos.ImagenUrl, detalle);

        if (eleccion == ModalEnviadoRevision.PublicarOtro)
        {
            _recienGuardado = null;
            if (Editando) Nav.NavigateTo(Acciones.Rutas.PublicarEvento);
            else { _cargado = null; await CargarAsync(); }
        }
        else if (eleccion == ModalEnviadoRevision.IrAlPanel)
        {
            // El panel de organizador aún no tiene pantalla: se va al inicio con el aviso de "próximamente".
            Acciones.Inicio();
            Acciones.PanelOrganizador();
        }
        else if (Id != id)
        {
            _cargado = id;
            Nav.NavigateTo(Acciones.Rutas.EditarEvento(id), replace: true);
        }
    }

    /// <summary>Lo mismo que revisa la BD, para marcar cada campo.</summary>
    /// <returns>Id de la primera sección con errores, o null si todo está bien.</returns>
    private string? Validar()
    {
        _errores.Limpiar();
        string? primera = null;
        void Error(string seccion, string campo, string mensaje)
        {
            _errores.Poner(campo, mensaje, enfocar: primera == null);
            primera ??= seccion;
        }

        string titulo = _titulo.Trim();
        if (titulo.Length == 0) Error("seccion-info", "titulo", "Escribe el título del evento.");
        else if (titulo.Length > MaximoTitulo) Error("seccion-info", "titulo", $"El título puede tener hasta {MaximoTitulo} caracteres.");
        if (string.IsNullOrWhiteSpace(_descripcion)) Error("seccion-info", "descripcion", "Escribe una descripción.");

        if (Fechas() is not { } f) Error("seccion-fecha", "fechas", "Elige la fecha y la hora de inicio y de fin.");
        else if (f.Fin <= f.Inicio) Error("seccion-fecha", "fechas", "La fecha de fin debe ser posterior a la de inicio.");

        if (_usarLugar)
        {
            if (LugarElegido == null) Error("seccion-ubicacion", "lugar", "Elige un lugar registrado.");
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_direccion)) Error("seccion-ubicacion", "direccion", "Escribe la dirección.");
            if (_lat is not { } lat || _lng is not { } lng) Error("seccion-ubicacion", "mapa", "Marca el punto exacto en el mapa.");
            else if (!DentroDeChihuahua(lat, lng)) Error("seccion-ubicacion", "mapa", "La ubicación debe estar dentro del estado de Chihuahua.");
        }

        if (_dePago)
        {
            decimal? min = Numero(_precioMin), max = Numero(_precioMax);
            if (min is not { } a || a < 0) Error("seccion-precio", "precioMin", "Escribe un precio válido (0 o más).");
            if (max is not { } b || b <= 0) Error("seccion-precio", "precioMax", "Escribe un precio mayor a 0.");
            else if (min is { } c && c > b) Error("seccion-precio", "precioMin", "El precio mínimo no puede ser mayor que el máximo.");
        }

        string boletos = _boletos.Trim();
        if (boletos.Length > 0 && (!Uri.TryCreate(boletos, UriKind.Absolute, out Uri? uri) || uri.Scheme is not ("https" or "http")))
            Error("seccion-precio", "boletos", "Escribe la dirección completa, empezando con https://");

        return primera;
    }

    private DatosEvento Datos()
    {
        var (inicio, fin) = Fechas()!.Value;
        decimal min = _dePago ? Numero(_precioMin) ?? 0 : 0;
        decimal max = _dePago ? Numero(_precioMax) ?? 0 : 0;
        return new DatosEvento
        {
            LugarId = _usarLugar ? _lugarId : null,
            Titulo = _titulo.Trim(),
            Descripcion = _descripcion.Trim(),
            Inicio = inicio,
            Fin = fin,
            // Con lugar registrado, la ubicación sale del lugar (v_event_card); el evento no guarda otra.
            Direccion = _usarLugar ? null : _direccion.Trim(),
            Latitud = _usarLugar ? null : _lat,
            Longitud = _usarLugar ? null : _lng,
            PrecioMin = min,
            PrecioMax = max,
            BoletosUrl = string.IsNullOrWhiteSpace(_boletos) ? null : _boletos.Trim(),
            ImagenUrl = _fotos.FirstOrDefault(),
            EtiquetaIds = [.. _etiquetas],
            Galeria = [.. _fotos.Skip(1)],
        };
    }

    // ---------------------------------------------------------------- Apoyo

    private (DateTime Inicio, DateTime Fin)? Fechas() =>
        Fecha(_inicioFecha, _inicioHora) is { } inicio && Fecha(_finFecha, _finHora) is { } fin ? (inicio, fin) : null;

    /// <summary>"2026-10-31" + "19:30" (lo que mandan los input date / time).</summary>
    private static DateTime? Fecha(string dia, string hora) =>
        DateTime.TryParseExact($"{dia} {hora}", ["yyyy-MM-dd HH:mm", "yyyy-MM-dd HH:mm:ss"], CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime valor)
            ? valor : null;

    /// <summary>Caja del estado de Chihuahua (los CHECK ck_event_lat / ck_event_lng).</summary>
    private static bool DentroDeChihuahua(decimal lat, decimal lng) => lat is >= 25.5m and <= 31.8m && lng is >= -109.2m and <= -103.3m;

    private static decimal? Numero(string texto) =>
        decimal.TryParse(texto.Trim().TrimStart('$').Replace(",", ""), NumberStyles.Number, CultureInfo.InvariantCulture, out decimal valor) ? valor : null;

    private static string Texto(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);

    private void AlCambiarSesion() => InvokeAsync(async () =>
    {
        int? id = Sesion.Usuario?.Id;
        if (id == _usuarioId) return;
        if (_usuarioId != null && id == null) { Acciones.Inicio(); return; }
        _cargado = null;
        await CargarAsync();
        StateHasChanged();
    });

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}
