@*
  "Explora por categoría" del Home ("Tile categoría" de Figma, Normal / Hover). Cada tile abre los resultados de
  búsqueda filtrados: las categorías de evento por su etiqueta y Cafés / Museos por tipo de lugar.
  Null = cargando; vacía = no se muestra.
*@
@inject Acciones Acciones

@if (Etiquetas is not { Count: 0 })
{
    <section class="home-seccion" aria-labelledby="titulo-categorias">
        <div class="contenedor">
            <h2 class="t-h2 home-seccion__titulo" id="titulo-categorias">Explora por categoría</h2>
            <div class="tiles">
                @if (Etiquetas == null)
                {
                    @foreach (var _ in Tiles)
                    {
                        <div class="esqueleto home__esqueleto-tile" aria-hidden="true"></div>
                    }
                }
                else
                {
                    @foreach (var etiqueta in Etiquetas)
                    {
                        if (!Tiles.TryGetValue(etiqueta.Icono, out var tile)) continue;
                        <button type="button" class="tile-categoria" style="--fondo-tile:@tile.Fondo" @onclick="() => Acciones.Buscar(Filtro(etiqueta, tile))">
                            <span class="tile-categoria__circulo"><Icono Nombre="@tile.Icono" Caja="18" /></span>
                            <span class="tile-categoria__nombre t-h3">@tile.Texto</span>
                            <span class="tile-categoria__flecha"><Icono Nombre="chevron-tinta-12" Caja="12" /></span>
                        </button>
                    }
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<Etiqueta>? Etiquetas { get; set; }

    /// <param name="Lugar">Tipo de lugar que busca el tile (Cafés, Museos); null = eventos de esa categoría.</param>
    private sealed record Tile(string Texto, string Icono, string Fondo, TipoBusqueda? Lugar = null);

    /// <summary>Tile de cada categoría, por tag.icon.</summary>
    private static readonly Dictionary<string, Tile> Tiles = new()
    {
        ["music"] = new("Música", "tile-musica", "var(--categoria-musica)"),
        ["family"] = new("Familiar", "tile-familiar", "var(--categoria-familiar)"),
        ["run"] = new("Aire libre", "tile-aire-libre", "var(--categoria-deportes)"),
        ["robot"] = new("Tecnología", "tile-tecnologia", "var(--categoria-tecnologia)"),
        ["food"] = new("Gastronomía", "tile-gastronomia", "var(--categoria-gastronomia)"),
        ["coffee"] = new("Cafés", "tile-cafes", "var(--categoria-cafes)", TipoBusqueda.Cafes),
        ["museum"] = new("Museos", "tile-museos", "var(--categoria-museos)", TipoBusqueda.Museos),
    };

    private static FiltroBusqueda Filtro(Etiqueta etiqueta, Tile tile) =>
        tile.Lugar is { } tipo ? new FiltroBusqueda { Tipos = [tipo] } : new FiltroBusqueda { Categorias = [etiqueta.Id] };
}
