@*
  Filtros rápidos del Home: Todo / Eventos / Lugares · Hoy · Este fin de semana · Gratis · Fecha · Filtros.
  Avisa con AlCambiar; el Home filtra lo que ya cargó (sin volver a consultar).
  "Fecha" (Calendario) y "Filtros" abren su modal y llevan a "Resultados de búsqueda" con lo elegido.
  Todo / Eventos / Lugares son FluentToggleButton (sus estilos van con ::deep porque son de Fluent).
*@
@inject Acciones Acciones
@inject Modales Modales

<div class="filtros-rapidos contenedor" role="toolbar" aria-label="Filtros rápidos">
    <div class="segmentos" role="group" aria-label="Mostrar">
        @foreach (var (valor, texto) in Tipos)
        {
            <FluentToggleButton Class="segmentos__opcion t-small-fuerte" Shape="ButtonShape.Circular" Pressed="Filtro.Tipo == valor"
                                OnClick="() => CambiarAsync(Filtro with { Tipo = valor })">@texto</FluentToggleButton>
        }
    </div>
    <span class="filtros-rapidos__divisor" aria-hidden="true"></span>
    @* "Hoy" y "Este fin de semana" se excluyen entre sí; tocar el activo lo quita. *@
    <Pildora Texto="Hoy" Activa="Filtro.Cuando == CuandoFiltro.Hoy" OnClick="() => AlternarCuandoAsync(CuandoFiltro.Hoy)" />
    <Pildora Texto="Este fin de semana" Activa="Filtro.Cuando == CuandoFiltro.FinDeSemana" OnClick="() => AlternarCuandoAsync(CuandoFiltro.FinDeSemana)" />
    <Pildora Texto="Gratis" Activa="Filtro.Gratis" OnClick="() => CambiarAsync(Filtro with { Gratis = !Filtro.Gratis })" />
    <span class="filtros-rapidos__espacio"></span>
    <Boton Texto="Fecha" Variante="secundario" Tamano="s" Icono="calendario-16-tinta" OnClick="ElegirFechaAsync" />
    <Boton Texto="Filtros" Variante="secundario" Tamano="s" Icono="filtros" OnClick="AbrirFiltrosAsync" />
</div>

@code {
    [Parameter, EditorRequired] public FiltroHome Filtro { get; set; } = FiltroHome.Ninguno;
    [Parameter] public EventCallback<FiltroHome> AlCambiar { get; set; }

    private static readonly (TipoFiltro, string)[] Tipos =
    [
        (TipoFiltro.Todo, "Todo"),
        (TipoFiltro.Eventos, "Eventos"),
        (TipoFiltro.Lugares, "Lugares"),
    ];

    private Task AlternarCuandoAsync(CuandoFiltro cuando) =>
        CambiarAsync(Filtro with { Cuando = Filtro.Cuando == cuando ? null : cuando });

    private Task CambiarAsync(FiltroHome nuevo) => AlCambiar.InvokeAsync(nuevo);

    /// <summary>"Fecha": Calendario y luego los resultados de ese día.</summary>
    private async Task ElegirFechaAsync()
    {
        if (await Modales.ElegirFechaAsync() is { } dia)
            Acciones.Buscar(ComoBusqueda() with { Cuando = FiltroCuando.Rango, Fecha = dia, Tipos = [] });
    }

    /// <summary>"Filtros": el modal empieza con lo que ya está puesto aquí y lleva a los resultados.</summary>
    private async Task AbrirFiltrosAsync()
    {
        if (await Modales.FiltrosAsync(ComoBusqueda()) is { } filtro) Acciones.Buscar(filtro);
    }

    /// <summary>Los filtros rápidos del Home pasados a los de la búsqueda.</summary>
    private FiltroBusqueda ComoBusqueda() => new()
    {
        Tipos = Filtro.Tipo switch
        {
            TipoFiltro.Eventos => [TipoBusqueda.Eventos],
            TipoFiltro.Lugares => [TipoBusqueda.Cafes, TipoBusqueda.Museos, TipoBusqueda.Parques],
            _ => [],
        },
        Cuando = Filtro.Cuando switch
        {
            CuandoFiltro.Hoy => FiltroCuando.Hoy,
            CuandoFiltro.FinDeSemana => FiltroCuando.EsteFinDeSemana,
            _ => FiltroCuando.Cualquiera,
        },
        Precio = Filtro.Gratis ? FiltroPrecio.Gratis : FiltroPrecio.Todos,
    };
}
