@*
  Fila de "Moderación / Reportes" de Figma: tipo y motivo, el evento o lugar (el título lo abre), la reseña y lo que
  escribieron quienes reportaron. El rojo queda para lo urgente: estafas y reportes que pasaron de las 48 horas. Los reportes repetidos del mismo objetivo van juntos en una fila y las
  acciones los cierran todos. Abierto: "Descartar" y, según el tipo, "Ocultar reseña" o "Ver evento" / "Ver lugar" y
  "Marcar resuelto" (ya se revisó). Si reabrieron el reporte de una reseña que sigue oculta: "Mantener oculta" o
  "Volver a mostrar" (descartarlo dejaría la reseña oculta sin motivo). Cerrado: "Reabrir" y, si sigue oculta,
  "Volver a mostrar".
*@
@inject Acciones Acciones

<article class="fila-reporte" aria-labelledby="@_idTitulo">
    <div class="fila-reporte__info">
        <div class="fila-reporte__etiquetas">
            <Chip Texto="@TipoTexto" Variante="fondo" Icono="@TipoIcono" Clase="chip--estado" />
            @foreach (var motivo in G.Reportes.Select(r => r.Reporte.Motivo).Distinct())
            {
                @if (motivo == MotivoReporte.Estafa)
                {
                    <Chip Texto="@MotivoTexto(motivo)" Variante="error-suave" Icono="alerta-error-12" Clase="chip--estado" />
                }
                else
                {
                    <Chip Texto="@MotivoTexto(motivo)" Variante="fondo" Clase="chip--estado" />
                }
            }
            @if (G.Reportantes.Count > 1)
            {
                <Chip Texto="@($"{G.Reportantes.Count} personas")" Variante="sol-suave" Clase="chip--estado" />
            }
            @if (EsResena && P.ResenaOculta)
            {
                <Chip Texto="Reseña oculta" Variante="sol-suave" Clase="chip--estado" />
            }
            @if (Abierto && Espera.TotalHours >= HorasLimite)
            {
                <Chip Texto="@($"Pasó de {HorasLimite} h")" Variante="error-suave" Icono="reloj-error-12" Clase="chip--estado" />
            }
            else if (Abierto && Espera.TotalHours >= HorasAviso)
            {
                <Chip Texto="Vence pronto" Variante="sol-suave" Icono="reloj-arena-12" Clase="chip--estado" />
            }
        </div>
        <h2 class="t-card-titulo" id="@_idTitulo">
            <button type="button" class="fila-reporte__titulo" @onclick="VerObjetivo">@Titulo</button>
        </h2>
        @if (EsResena)
        {
            <div class="fila-reporte__bloque fila-reporte__bloque--resena">
                <p class="t-caption texto-2">
                    Reseña de @@@P.ResenaAutor ·
                    <span role="img" aria-label="@($"{P.ResenaCalificacion} de 5 estrellas")">@(new string('★', P.ResenaCalificacion ?? 0))</span>
                </p>
                @if (P.ResenaComentario is { } comentario)
                {
                    <TextoLargo Texto="@comentario" Comillas />
                }
                else
                {
                    <p class="t-small texto-2">Sin comentario</p>
                }
            </div>
        }
        @foreach (var r in _todosLosComentarios ? Comentarios : Comentarios.Take(1))
        {
            <div @key="r.Reporte.Id" class="fila-reporte__bloque">
                <p class="t-caption texto-2">Comentario de @@@r.ReportanteNombre</p>
                <TextoLargo Texto="@(r.Reporte.Detalles!)" />
            </div>
        }
        @if (Comentarios.Count > 1)
        {
            <button type="button" class="fila-reporte__mas t-small-fuerte" aria-expanded="@(_todosLosComentarios ? "true" : "false")" @onclick="() => _todosLosComentarios = !_todosLosComentarios">
                @(_todosLosComentarios ? "Ver menos comentarios" : Comentarios.Count == 2 ? "Ver 1 comentario más" : $"Ver {Comentarios.Count - 1} comentarios más")
            </button>
        }
        <p class="fila-reporte__meta t-caption texto-2">
            <Icono Nombre="persona-gris-12" Caja="12" />
            <span>@Meta</span>
        </p>
    </div>
    <div class="fila-reporte__acciones">
        @if (Abierto && EsResena && P.ResenaOculta)
        {
            <Boton Texto="Volver a mostrar" Variante="secundario" Tamano="s" Icono="ojo-tinta-16" Deshabilitado="Ocupado" OnClick="AlMostrar" aria-label="@($"Volver a mostrar: {Titulo}")" />
            <Boton Texto="Mantener oculta" Variante="oscuro" Tamano="s" Icono="check-blanco-16" Deshabilitado="Ocupado" OnClick="AlResolver" aria-label="@($"Mantener oculta: {Titulo}")" />
        }
        else if (Abierto)
        {
            <Boton Texto="Descartar" Variante="fantasma" Tamano="s" Deshabilitado="Ocupado" OnClick="AlDescartar" aria-label="@($"Descartar: {Titulo}")" />
            @if (EsResena)
            {
                <Boton Texto="Ocultar reseña" Variante="secundario" Tamano="s" Icono="ojo-tachado-tinta-16" Deshabilitado="Ocupado" OnClick="AlOcultar" aria-label="@($"Ocultar reseña: {Titulo}")" />
            }
            else
            {
                <Boton Texto="@VerTexto" Variante="secundario" Tamano="s" Icono="ojo-tinta-16" OnClick="VerObjetivo" aria-label="@($"{VerTexto}: {P.ObjetivoNombre}")" />
                <Boton Texto="Marcar resuelto" Variante="oscuro" Tamano="s" Icono="check-blanco-16" Deshabilitado="Ocupado" OnClick="AlResolver" aria-label="@($"Marcar resuelto: {Titulo}")" />
            }
        }
        else
        {
            <Boton Texto="Reabrir" Variante="fantasma" Tamano="s" Deshabilitado="Ocupado" OnClick="AlReabrir" aria-label="@($"Reabrir: {Titulo}")" />
            @if (EsResena && P.ResenaOculta)
            {
                <Boton Texto="Volver a mostrar" Variante="secundario" Tamano="s" Icono="ojo-tinta-16" Deshabilitado="Ocupado" OnClick="AlMostrar" aria-label="@($"Volver a mostrar: {Titulo}")" />
            }
        }
    </div>
</article>

@code {
    /// <summary>Se le promete a quien reporta una revisión en este tiempo ("Modal / Reporte enviado").</summary>
    private const int HorasLimite = 48;
    private const int HorasAviso = 36;

    private static int _siguiente;
    private readonly string _idTitulo = $"reporte-{Interlocked.Increment(ref _siguiente)}";

    [Parameter, EditorRequired] public GrupoReportes G { get; set; } = default!;
    /// <summary>Mientras se guarda una decisión de esta u otra fila.</summary>
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public EventCallback AlDescartar { get; set; }
    [Parameter] public EventCallback AlResolver { get; set; }
    [Parameter] public EventCallback AlOcultar { get; set; }
    [Parameter] public EventCallback AlReabrir { get; set; }
    [Parameter] public EventCallback AlMostrar { get; set; }

    private bool _todosLosComentarios;

    private ReporteDetalle P => G.Principal;
    private List<ReporteDetalle> Comentarios => [.. G.Reportes.Where(r => r.Reporte.Detalles != null)];
    private bool Abierto => P.Reporte.Estado == EstadoReporte.Abierto;
    private bool EsResena => P.Reporte.Tipo is TipoObjetivoReporte.ResenaEvento or TipoObjetivoReporte.ResenaLugar;
    private string VerTexto => P.EventoId != null ? "Ver evento" : "Ver lugar";
    private string Titulo => EsResena ? $"Reseña en {P.ObjetivoNombre}" : P.ObjetivoNombre;

    /// <summary>Lo que lleva esperando el reporte más antiguo del grupo.</summary>
    private TimeSpan Espera => DateTime.Now - G.Reportes.Min(r => r.Reporte.CreadoEn);

    private string Meta
    {
        get
        {
            var personas = G.Reportantes;
            string quienes = personas.Count switch
            {
                1 => $"@{personas[0]}",
                2 => $"@{personas[0]} y @{personas[1]}",
                _ => $"@{personas[0]} y {personas.Count - 1} más",
            };
            string cuando = Formato.Hace(G.Reportes.Min(r => r.Reporte.CreadoEn)).ToLowerInvariant();
            string texto = $"Reportado por {quienes} · {cuando}";
            if (P.Reporte.ResueltoEn is { } cerrado)
                texto += $" · {(P.Reporte.Estado == EstadoReporte.Resuelto ? "Resuelto" : "Descartado")} {Formato.Hace(cerrado).ToLowerInvariant()}";
            return texto;
        }
    }

    private string TipoTexto => P.Reporte.Tipo switch
    {
        TipoObjetivoReporte.Evento => "Evento",
        TipoObjetivoReporte.Lugar => "Lugar",
        TipoObjetivoReporte.ResenaEvento => "Reseña de evento",
        _ => "Reseña de lugar",
    };

    private string TipoIcono => P.Reporte.Tipo switch
    {
        TipoObjetivoReporte.Evento => "calendario-tinta-12",
        TipoObjetivoReporte.Lugar => "ubicacion-tinta-12",
        _ => "comentario-tinta-12",
    };

    private static string MotivoTexto(MotivoReporte motivo) => motivo switch
    {
        MotivoReporte.Spam => "Spam",
        MotivoReporte.Estafa => "Estafa",
        MotivoReporte.Inapropiado => "Inapropiado",
        MotivoReporte.InformacionFalsa => "Información falsa",
        _ => "Otro",
    };

    private void VerObjetivo()
    {
        if (P.EventoId is { } evento) Acciones.VerEvento(evento);
        else if (P.LugarId is { } lugar) Acciones.VerLugar(lugar);
    }
}
