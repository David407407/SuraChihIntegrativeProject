@*
  Encabezado de las pantallas de moderación: compacto, para que el trabajo se vea sin bajar. Insignia azul, título,
  texto y el moderador a la derecha.
*@
<header class="encabezado">
    <span class="encabezado__insignia"><Icono Nombre="escudo-blanco-22" Caja="22" /></span>
    <div class="encabezado__titulo">
        <h1 class="t-h2">@Titulo</h1>
        <p class="t-small texto-2">@Texto</p>
    </div>
    @if (Usuario is { EsModerador: true } usuario)
    {
        <p class="encabezado__moderador t-small-fuerte">
            <span class="encabezado__avatar" aria-hidden="true">@usuario.NombreUsuario[..1].ToUpperInvariant()</span>
            <span>@usuario.NombreUsuario · @(usuario.EsSuperModerador ? "Supermoderador" : "Moderador")</span>
        </p>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public string Texto { get; set; } = "";
    /// <summary>El usuario de la sesión (por parámetro para que se vuelva a pintar cuando cambia).</summary>
    [Parameter] public Usuario? Usuario { get; set; }
}
