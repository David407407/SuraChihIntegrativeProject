@*
  Pestañas de las pantallas de moderación: Publicaciones, Organizadores, Reportes e Historial con su conteo
  (subrayado sol en la activa). "Equipo" solo le sale a un supermoderador. Sin conteo (null: aún cargando) se
  muestra 0.
*@
@inject Sesion Sesion
@inject Acciones Acciones
@inject InteropJs Js

<nav class="pestanas" aria-label="Secciones de moderación">
    @Pestana("Publicaciones", Publicaciones, Seccion.Publicaciones, () => Acciones.IrA(Acciones.Rutas.Moderacion))
    @Pestana("Organizadores", Organizadores, Seccion.Organizadores, () => Acciones.IrA(Acciones.Rutas.ModeracionOrganizadores))
    @Pestana("Reportes", Reportes, Seccion.Reportes, () => Acciones.IrA(Acciones.Rutas.ModeracionReportes))
    <button type="button" class="pestana @(Activa == Seccion.Historial ? "pestana--activa" : "")" aria-current="@(Activa == Seccion.Historial ? "page" : null)"
            @onclick="() => Acciones.IrA(Acciones.Rutas.ModeracionHistorial)">
        <span class="pestana__etiqueta">Historial</span>
    </button>
    @if (Sesion.Usuario?.EsSuperModerador == true)
    {
        <button type="button" class="pestana" @onclick="() => Acciones.IrA(Acciones.Rutas.EquipoModeracion)">
            <span class="pestana__etiqueta">Equipo</span>
        </button>
    }
</nav>

@code {
    public enum Seccion { Publicaciones, Organizadores, Reportes, Historial }

    [Parameter, EditorRequired] public Seccion Activa { get; set; }
    [Parameter] public int? Publicaciones { get; set; }
    [Parameter] public int? Organizadores { get; set; }
    [Parameter] public int? Reportes { get; set; }

    /// <summary>Al cambiar de pantalla: la activa queda a la vista (en angosto puede salir de la fila) y con el foco.</summary>
    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (primeraVez) await Js.LlamarAsync("mostrarPestana", ".pestana--activa");
    }

    private RenderFragment Pestana(string texto, int? conteo, Seccion? seccion, Action alElegir)
    {
        bool activa = seccion == Activa;
        return @<button type="button" class="pestana @(activa ? "pestana--activa" : "")" aria-current="@(activa ? "page" : null)" @onclick="alElegir">
            <span class="pestana__etiqueta">@texto<span class="pestana__conteo @(activa ? "pestana__conteo--activo" : "")">@(conteo ?? 0)</span></span>
        </button>;
    }
}
