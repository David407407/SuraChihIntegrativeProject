@*
  Botón "Continuar con Google" del diseño (modales Iniciar sesión y Crear cuenta).
  Abre el navegador del sistema para elegir la cuenta (ServicioCuenta.ContinuarConGoogleAsync). Con la
  cuenta lista, cierra la modal y saluda. Si algo falla, el mensaje sale en Errores.
  AlAvisar es para que la modal que lo contiene se vuelva a pintar y muestre el aviso.
*@
@inject ServicioCuenta Cuenta
@inject Modales Modales
@inject Avisos Avisos
@inject ILogger<BotonesSociales> Registro

<div class="modal__sociales">
    <Boton Texto="@(_esperando ? "Termina en tu navegador…" : "Continuar con Google")" Variante="secundario" Clase="modal__ancho"
           Ocupado="_esperando" OnClick="ContinuarAsync" />
</div>
<p class="modal__separador t-caption">o con tu correo</p>

@code {
    [Parameter, EditorRequired] public ErroresFormulario Errores { get; set; } = default!;
    [Parameter] public EventCallback AlAvisar { get; set; }

    /// <summary>El navegador está abierto esperando la cuenta.</summary>
    private bool _esperando;

    private async Task ContinuarAsync()
    {
        Errores.Limpiar();
        _esperando = true;
        try
        {
            var (usuario, nueva) = await Cuenta.ContinuarConGoogleAsync();
            Modales.Cerrar();
            Avisos.Mostrar(nueva ? $"¡Bienvenido a SuraChih, {usuario.NombreUsuario}!" : $"¡Hola de nuevo, {usuario.NombreUsuario}!");
        }
        catch (Exception ex)
        {
            if (ex is not BackendLogica.Datos.SuraChihException) Registro.LogError(ex, "Falló Continuar con Google");
            Errores.PonerAviso(MensajesError.Para(ex));
            await AlAvisar.InvokeAsync();
        }
        finally
        {
            _esperando = false;
        }
    }
}
