@*
  "Modal / Reporte enviado" de Figma: insignia verde, "Gracias por avisarnos" y "Listo".
  La abre "Modal / Reportar" después de guardar el reporte. Con Repetido dice "Ya reportaste esto": cada persona
  reporta una vez, y el aviso no promete las 48 horas porque ese reporte quizá ya se revisó.
*@
@inject Modales Modales

<EncabezadoModal Titulo="@(Repetido ? "Ya reportaste esto" : "Gracias por avisarnos")" Icono="check-circulo-exito-24" Exito
                 Texto="@(Repetido ? "Tu reporte ya le llegó a moderación. Solo se envía uno por persona." : "Revisaremos el reporte en las próximas 48 horas.")" />
<Boton Texto="Listo" Variante="oscuro" Clase="modal__ancho" data-cerrar-modal OnClick="() => Modales.Cerrar()" />

@code {
    [Parameter] public bool Repetido { get; set; }
}
