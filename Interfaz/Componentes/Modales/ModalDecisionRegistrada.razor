@*
  "Modal / Decisión registrada" y "Modal / Evento cancelado" de Figma: confirmación centrada, sin botones. La abre
  Modales.DecisionRegistradaAsync() o EventoCanceladoAsync() y se cierra sola.
*@
<div class="registrada" role="status">
    <div class="modal__icono modal__icono--exito"><Icono Nombre="check-exito-24" Caja="24" /></div>
    <h2 class="modal__titulo t-h2" id="modal-titulo">@Titulo</h2>
    <p class="t-body texto-2">@Texto</p>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "Decisión registrada";
    [Parameter] public string Texto { get; set; } = "Quedó en el historial con fecha y comentario.";
}
