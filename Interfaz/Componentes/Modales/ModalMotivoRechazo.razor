@*
  "Modal / Motivo de rechazo" de Figma: lo que ve el ORGANIZADOR cuando moderación rechaza su evento
  ("Tu evento fue rechazado", quién y cuándo, el comentario y "Editar y reenviar").
  Lo abre el panel del organizador con Modales.MotivoRechazo(titulo, registro, id), donde registro sale de
  bd.Moderacion.ObtenerUltimaDecisionAsync(TipoObjetivoModeracion.Evento, id). "Editar y reenviar" abre la
  pantalla de Publicar evento con ese evento (en /componentes, sin id, solo cierra).
*@
@inject Modales Modales
@inject Acciones Acciones

<EncabezadoModal Titulo="Tu evento fue rechazado" Icono="x-circulo-error" Peligro
                 Texto="@($"{Titulo} no se publicó. Esto es lo que indicó moderación:")" />
<div class="motivo">
    <p class="motivo__autor t-caption">
        <Icono Nombre="comentario-error-14" Caja="14" />
        <span>@Registro.ModeradorNombre · @Formato.RangoFechas(Registro.DecididoEn), @Registro.DecididoEn.ToString("HH:mm")</span>
    </p>
    <p class="t-body">@(Registro.Comentario ?? "Sin comentario.")</p>
</div>
<p class="t-small texto-2">Al reenviarlo vuelve a pasar por revisión.</p>
<div class="modal__botones">
    <Boton Texto="Editar y reenviar" Icono="editar-18" Clase="modal__ancho" OnClick="EditarYReenviar" />
    <Boton Texto="Cerrar" Variante="secundario" Clase="modal__ancho" data-cerrar-modal OnClick="() => Modales.Cerrar()" />
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public RegistroModeracion Registro { get; set; } = default!;

    /// <summary>Evento rechazado que se edita al reenviar.</summary>
    [Parameter] public int? EventoId { get; set; }

    private void EditarYReenviar()
    {
        Modales.Cerrar();
        if (EventoId is { } id) Acciones.EditarEvento(id);
    }
}
