@* Aviso dentro de la modal, junto al formulario (p. ej. "Correo o contraseña incorrectos"). Muestra Errores.Aviso. *@
@if (Errores.Aviso is { } aviso)
{
    <p class="modal__aviso @(Errores.AvisoInformativo ? " modal__aviso--info" : "")" role="alert">@aviso</p>
}

@code {
    [Parameter, EditorRequired] public ErroresFormulario Errores { get; set; } = default!;
}
