@*
  "Modal / Rechazar" de Figma: insignia roja, motivos (Opcion, uno a la vez), comentario obligatorio y
  "Rechazar" (rojo) / "Volver". Sirve para eventos (Modales.RechazarEventoAsync; el comentario llega con lo que
  ya se escribió en la tarjeta "Decisión") y para solicitudes de organizador (Modales.RechazarOrganizadorAsync).
  El autor ve el motivo y el comentario ("Motivo de rechazo" o la pantalla "Hazte organizador").
*@
@inject ServicioModeracion Moderacion
@inject Modales Modales

<EncabezadoModal Titulo="Rechazar" Icono="x-circulo-error" Peligro
                 Texto="Elige el motivo principal. El solicitante verá tu comentario." />
<EditForm Model="this" OnSubmit="RechazarAsync" class="modal__formulario" novalidate>
    <div class="rechazar__motivos" role="radiogroup" aria-label="Motivo del rechazo">
        @foreach (var motivo in Motivos)
        {
            <Opcion Texto="@motivo" Grupo="motivo-rechazo" Seleccionada="_motivo == motivo" OnClick="() => _motivo = motivo" />
        }
    </div>
    <AreaTexto Nombre="comentario" Etiqueta="Comentario (obligatorio)" Filas="3" Maximo="500"
               Placeholder="@($"Qué debe corregir el {Autor}")" @bind-Valor="_comentario" Errores="_errores" />
    <AvisoModal Errores="_errores" />
    <div class="modal__botones">
        <Boton Texto="Rechazar" Variante="peligro" Icono="x-circulo-blanco-18" Tipo="submit" Clase="modal__ancho" Ocupado="_enviando" />
        <Boton Texto="Volver" Variante="secundario" Clase="modal__ancho" data-cerrar-modal OnClick="() => Modales.Cerrar()" />
    </div>
</EditForm>

@code {
    /// <summary>Evento u Organizador (el id del usuario que solicitó).</summary>
    [Parameter, EditorRequired] public TipoObjetivoModeracion Tipo { get; set; }
    [Parameter, EditorRequired] public int ObjetivoId { get; set; }
    [Parameter] public string? Comentario { get; set; }

    private readonly ErroresFormulario _errores = new();
    private string _motivo = "";
    private string? _comentario;
    private bool _enviando;

    private bool EsOrganizador => Tipo == TipoObjetivoModeracion.Organizador;
    private string Autor => EsOrganizador ? "solicitante" : "organizador";
    private string[] Motivos => EsOrganizador ? ServicioModeracion.MotivosRechazoOrganizador : ServicioModeracion.MotivosRechazo;

    protected override void OnInitialized()
    {
        _comentario = Comentario;
        _motivo = Motivos[0];
    }

    private async Task RechazarAsync()
    {
        _errores.Limpiar();
        if (string.IsNullOrWhiteSpace(_comentario))
        {
            _errores.Poner("comentario", $"Escribe qué debe corregir el {Autor}.");
            return;
        }

        _enviando = true;
        try
        {
            if (EsOrganizador) await Moderacion.RechazarOrganizadorAsync(ObjetivoId, _motivo, _comentario);
            else await Moderacion.RechazarAsync(ObjetivoId, _motivo, _comentario);
            Modales.Cerrar(true);
        }
        catch (Exception ex)
        {
            _errores.PonerAviso(MensajesError.Para(ex));
        }
        finally
        {
            _enviando = false;
        }
    }
}
