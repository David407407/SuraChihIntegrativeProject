@*
  "Pildora" de Figma (Normal / Activa): una opción de un grupo de segmentos, p. ej. los tipos de lugar
  del mapa (Todo · Cafés · Museos · Parques). Solo una del grupo va activa.

  <div role="group" aria-label="Tipo de lugar">
    <Pildora Texto="Todo" Activa="tipo == null" OnClick="() => tipo = null" />
    <Pildora Texto="Cafés" Activa='tipo == "coffee"' OnClick='() => tipo = "coffee"' />
  </div>

  Por dentro es un FluentToggleButton (Pressed = Activa). Estilos en css/controles.css.
*@
<FluentToggleButton Class="pildora t-small-fuerte" Shape="ButtonShape.Circular" Pressed="Activa" OnClick="() => OnClick.InvokeAsync()">@Texto</FluentToggleButton>

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = "";
    [Parameter] public bool Activa { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
