@*
  Botón del sistema de diseño (componente "Botón" de Figma: 5 tipos × 2 tamaños).

  <Boton Texto="Voy a ir" Icono="calendario-check" OnClick="..." />
  <Boton Texto="Eliminar cuenta" Variante="peligro" Tamano="s" OnClick="..." />
  <Boton Texto="Entrar" Tipo="submit" Ocupado="enviando" />          dentro de un <form>
  <Boton Texto="Comprar boletos" Href="https://..." Externo />         enlace

  Variantes: primario · oscuro · secundario · peligro · fantasma (las de Figma), contorno-claro (hero azul)
  y blanco (carrusel del Home). Tamaños: m (48px) · s (36px).
  Cualquier otro atributo (aria-*, data-*...) pasa tal cual al botón.

  Por dentro es un FluentButton (o FluentAnchorButton con Href) de Fluent UI. Los colores, tamaños y la
  forma de Figma están en css/controles.css: el CSS aislado de este archivo no llega a los componentes de Fluent.
*@
@if (Decorativo)
{
    <span class="@Clases" aria-hidden="true" @attributes="Atributos">@Contenido</span>
}
else if (Href != null)
{
    <FluentAnchorButton Class="@Clases" Href="@Href" Target="@(Externo ? LinkTarget.Blank : null)" Rel="@(Externo ? "noopener noreferrer" : null)"
                        Appearance="Apariencia" Shape="ButtonShape.Circular" Size="Medida"
                        AdditionalAttributes="@Con("aria-disabled", Deshabilitado)">@Contenido</FluentAnchorButton>
}
else
{
    <FluentButton Class="@Clases" Type="@(Tipo == "submit" ? ButtonType.Submit : ButtonType.Button)"
                  Appearance="Apariencia" Shape="ButtonShape.Circular" Size="Medida"
                  Disabled="@(Deshabilitado || Ocupado)"
                  OnClick="AlHacerClic" AdditionalAttributes="@Con("aria-busy", Ocupado)">@Contenido</FluentButton>
}

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = "";
    [Parameter] public string Variante { get; set; } = "primario";
    [Parameter] public string Tamano { get; set; } = "m";
    /// <summary>Nombre del icono (ver <see cref="Icono"/>). En oscuro y peligro se pinta blanco.</summary>
    [Parameter] public string? Icono { get; set; }
    /// <summary>El icono va después del texto ("Ver detalles  ›").</summary>
    [Parameter] public bool IconoAlFinal { get; set; }
    /// <summary>Con <c>Href</c> se pinta como enlace.</summary>
    [Parameter] public string? Href { get; set; }
    /// <summary>Con <c>Href</c>: abre la página fuera de la app (en la de escritorio, en el navegador del sistema).</summary>
    [Parameter] public bool Externo { get; set; }
    /// <summary>"button" o "submit" (enviar el formulario).</summary>
    [Parameter] public string Tipo { get; set; } = "button";
    [Parameter] public bool Deshabilitado { get; set; }
    /// <summary>Mientras se espera la respuesta: mismo tamaño, con un indicador que gira, y no se puede volver a pulsar.</summary>
    [Parameter] public bool Ocupado { get; set; }
    /// <summary>Solo se ve como botón, pero no lo es (p. ej. "Ver detalles" dentro de una tarjeta que ya es clicable).</summary>
    [Parameter] public bool Decorativo { get; set; }
    /// <summary>Clases extra (las pone el componente padre para acomodarlo).</summary>
    [Parameter] public string? Clase { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Atributos { get; set; }

    private string Clases =>
        $"boton boton--{Variante} boton--{Tamano}{(IconoAlFinal ? " boton--icono-final" : "")}{(Ocupado ? " boton--ocupado" : "")} {Clase}".TrimEnd();

    /// <summary>La apariencia de Fluent más cercana a la variante (los colores exactos los pone controles.css).</summary>
    private ButtonAppearance Apariencia => Variante switch
    {
        "primario" or "oscuro" or "peligro" => ButtonAppearance.Primary,
        "secundario" or "contorno-claro" => ButtonAppearance.Outline,
        "fantasma" => ButtonAppearance.Transparent,
        _ => ButtonAppearance.Default,
    };

    private ButtonSize Medida => Tamano == "s" ? ButtonSize.Medium : ButtonSize.Large;

    /// <summary>El icono va en la ranura start / end de Fluent (así toma la separación del botón) y el texto en la principal.</summary>
    private RenderFragment Contenido => @<text>@if (Icono != null) {<span class="boton__icono" slot="@(IconoAlFinal ? "end" : "start")"><Icono Nombre="@Icono" Caja="@(Tamano == "m" ? 18 : 16)" /></span>}<span>@Texto</span>@if (Ocupado) {<FluentSpinner Class="boton__espera" Size="SpinnerSize.Tiny" />}</text>;

    /// <summary>Los atributos extra más uno de estado (aria-busy, aria-disabled) cuando aplica.</summary>
    private Dictionary<string, object> Con(string atributo, bool activo)
    {
        var todos = Atributos?.ToDictionary(a => a.Key, a => a.Value) ?? [];
        if (activo) todos[atributo] = "true";
        return todos;
    }

    private Task AlHacerClic(MouseEventArgs e) => OnClick.InvokeAsync(e);
}
