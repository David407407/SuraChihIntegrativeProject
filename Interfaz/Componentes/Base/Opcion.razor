@*
  "Opción" de Figma (48px, radio a la izquierda; seleccionada en sol suave con borde sol): una opción de
  un grupo en el que solo se elige una (motivos de "Rechazar"). Va dentro de un role="radiogroup".
  Por dentro es un radio nativo: el teclado funciona solo (Tab entra al grupo, las flechas cambian de opción).

  <div role="radiogroup" aria-label="Motivo">
      <Opcion Texto="Otro" Grupo="motivo" Seleccionada="_motivo == ..." OnClick="() => _motivo = ..." />
  </div>
*@
<label class="opcion @(Seleccionada ? "opcion--activa" : "") @Clase">
    <input type="radio" class="solo-lectores" name="@Grupo" checked="@Seleccionada" @onchange="() => OnClick.InvokeAsync()" />
    <Icono Nombre="@(Seleccionada ? "radio-activo" : "radio")" Caja="18" />
    <span class="t-body">@Texto</span>
</label>

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = "";
    /// <summary>Nombre compartido por las opciones del grupo.</summary>
    [Parameter] public string Grupo { get; set; } = "opcion";
    [Parameter] public bool Seleccionada { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Clase { get; set; }
}
