@*
  Campo de texto (componente "Campo" de Figma): icono a la izquierda, 48px de alto. Las contraseñas
  traen un botón "Mostrar" / "Ocultar". El error sale de Errores[Nombre] (o del parámetro Error) y se
  quita al volver a escribir.

  <Campo Nombre="correo" Etiqueta="Correo electrónico" Tipo="email" Icono="correo" @bind-Valor="correo" Errores="errores" />
  <Campo Nombre="contrasena" Etiqueta="Contraseña" Tipo="password" Ayuda="Mínimo 8 caracteres" @bind-Valor="contrasena" />
*@
<div class="@Clases">
    <label class="campo__etiqueta t-small-fuerte @(EtiquetaVisible ? "" : " solo-lectores")" for="@_id">@Etiqueta</label>
    <div class="campo__caja">
        @if (Icono != null)
        {
            <Icono Nombre="@Icono" />
        }
        <input @ref="_entrada" class="campo__entrada" id="@_id" name="@Nombre" type="@(_mostrar ? "text" : Tipo)"
               value="@Valor" @oninput="AlEscribir" placeholder="@(Placeholder ?? Etiqueta)"
               aria-describedby="@($"{_id}-error{(Ayuda != null ? $" {_id}-ayuda" : "")}")"
               required="@Requerido" disabled="@Deshabilitado" aria-invalid="@(MensajeError != null ? "true" : null)"
               autocomplete="@Autocompletar" maxlength="@Maximo" />
        @if (Tipo == "password")
        {
            <button type="button" class="campo__ver" aria-controls="@_id" aria-pressed="@(_mostrar ? "true" : "false")"
                    @onclick="() => _mostrar = !_mostrar">@(_mostrar ? "Ocultar" : "Mostrar")</button>
        }
    </div>
    @if (Ayuda != null)
    {
        <p class="campo__ayuda t-caption" id="@_id-ayuda">@Ayuda</p>
    }
    <p class="campo__error t-caption" id="@_id-error" role="alert">@MensajeError</p>
</div>

@code {
    private static int _siguiente;
    private readonly string _id = $"campo-{Interlocked.Increment(ref _siguiente)}";
    private ElementReference _entrada;
    private bool _mostrar;
    /// <summary>El usuario ya escribió después de que llegó el parámetro Error: no se muestra.</summary>
    private bool _errorFijoVisto;
    private string? _errorAnterior;

    /// <summary>Atributo name y clave en <see cref="Errores"/>.</summary>
    [Parameter, EditorRequired] public string Nombre { get; set; } = "";
    /// <summary>Texto de la etiqueta (y del placeholder si no se da otro).</summary>
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    /// <summary>false = la etiqueta solo la leen los lectores de pantalla (como en Figma).</summary>
    [Parameter] public bool EtiquetaVisible { get; set; }
    /// <summary>text, email, password, search, tel, url, number, date, time.</summary>
    [Parameter] public string Tipo { get; set; } = "text";
    /// <summary>Icono de 16px de assets/iconos (p. ej. "correo", "buscar-gris").</summary>
    [Parameter] public string? Icono { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Valor { get; set; }
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    /// <summary>Texto pequeño debajo.</summary>
    [Parameter] public string? Ayuda { get; set; }
    /// <summary>Mensaje de error fijo (borde rojo). Para errores que cambian, usa <see cref="Errores"/>.</summary>
    [Parameter] public string? Error { get; set; }
    [Parameter] public ErroresFormulario? Errores { get; set; }
    [Parameter] public bool Requerido { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    /// <summary>Atributo autocomplete ("email", "current-password"...).</summary>
    [Parameter] public string? Autocompletar { get; set; }
    /// <summary>maxlength.</summary>
    [Parameter] public int? Maximo { get; set; }

    private string Clases => $"campo{(MensajeError != null ? " campo--error" : "")}{(Deshabilitado ? " campo--deshabilitado" : "")}";

    private string? MensajeError => Errores?[Nombre] ?? (_errorFijoVisto ? null : Error);

    protected override void OnParametersSet()
    {
        if (Error != _errorAnterior) _errorFijoVisto = false;
        _errorAnterior = Error;
    }

    public ValueTask EnfocarAsync() => _entrada.FocusAsync();

    private async Task AlEscribir(ChangeEventArgs e)
    {
        Errores?.Quitar(Nombre);
        _errorFijoVisto = true;
        await ValorChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (Errores?.TomarFoco(Nombre) == true) await EnfocarAsync();
    }
}
