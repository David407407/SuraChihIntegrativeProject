<!--
  Única ventana de la app (tamaño de diseño 1366 × 820, centrada): un BlazorWebView que la ocupa toda.
  Monta Interfaz.Rutas en #app (wwwroot/index.html) y HeadOutlet en <head> para los títulos de cada pantalla.
-->
<Window x:Class="SuraChihIntegrativeProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:interfaz="clr-namespace:Interfaz;assembly=Interfaz"
        xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
        Title="SuraChih"
        Icon="Resources/AppIcon/appicon.ico"
        Width="1366" Height="820" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot\index.html"
                          Services="{DynamicResource servicios}"
                          BlazorWebViewInitialized="AlInicializarWebView">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type interfaz:Rutas}" />
            <blazor:RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

</Window>
