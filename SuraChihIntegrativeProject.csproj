<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    App de escritorio: WPF (Windows) con BlazorWebView. La ventana pinta los componentes Razor del
    proyecto Interfaz, que llaman directo a BackendLogica. El resultado es un .exe normal.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>SuraChihIntegrativeProject</RootNamespace>
    <AssemblyName>SuraChih</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Permite compilarla (no abrirla) desde macOS o Linux; para abrirla se necesita Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
    <Product>SuraChih</Product>
    <Version>0.2.0</Version>

    <!-- Otros proyectos y código viejo viven en subcarpetas: no compilarlos dentro de este -->
    <DefaultItemExcludes>$(DefaultItemExcludes);BackendLogica\**;BackendLogica.Pruebas\**;Interfaz\**;Interfaz.Navegador\**;Legacy\**;Prototipo\**;BaseDeDatos\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icono de la ventana y de la barra de tareas: el sol de SuraChih sobre tinta -->
    <Resource Include="Resources\AppIcon\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BackendLogica\BackendLogica.csproj" />
    <ProjectReference Include="Interfaz\Interfaz.csproj" />
  </ItemGroup>

</Project>
