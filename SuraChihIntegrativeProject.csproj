<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite compilar (no ejecutar) desde macOS/Linux; en Windows no cambia nada -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Otros proyectos y código viejo viven en subcarpetas: no compilarlos dentro de este -->
  <ItemGroup>
    <Compile Remove="BackendLogica\**;BackendLogica.Pruebas\**;Legacy\**" />
    <EmbeddedResource Remove="BackendLogica\**;BackendLogica.Pruebas\**;Legacy\**" />
    <None Remove="BackendLogica\**;BackendLogica.Pruebas\**;Legacy\**" />
  </ItemGroup>

  <!-- La interfaz (HTML/CSS/JS + imágenes) se copia junto al ejecutable y la carga WebView2 -->
  <ItemGroup>
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BackendLogica\BackendLogica.csproj" />
  </ItemGroup>

</Project>
