<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Las subcarpetas son proyectos propios; no compilarlas dentro de este -->
  <ItemGroup>
    <Compile Remove="BackendLogica\**;PruebaBackend\**" />
    <EmbeddedResource Remove="BackendLogica\**;PruebaBackend\**" />
    <None Remove="BackendLogica\**;PruebaBackend\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

  <!-- Tipografías (.ttf) e imágenes (hero.jpg, evento1.jpg...) se copian junto al ejecutable -->
  <ItemGroup>
    <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BackendLogica\BackendLogica.csproj" />
  </ItemGroup>

</Project>