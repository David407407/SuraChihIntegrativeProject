<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    App de escritorio: .NET MAUI (Windows y macOS vía Mac Catalyst) con BlazorWebView. La ventana pinta los componentes
    Razor del proyecto Interfaz, que llaman directo a BackendLogica.
  -->
  <PropertyGroup>
    <!-- Cada quien compila solo para su sistema: Windows en Windows, Mac Catalyst en macOS -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SuraChihIntegrativeProject</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>SuraChih</ApplicationTitle>
    <ApplicationId>mx.utch.surachih</ApplicationId>
    <ApplicationDisplayVersion>0.2</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- Otros proyectos y código viejo viven en subcarpetas: no compilarlos dentro de este -->
    <DefaultItemExcludes>$(DefaultItemExcludes);BackendLogica\**;BackendLogica.Pruebas\**;Interfaz\**;Interfaz.Navegador\**;Legacy\**;Prototipo\**;BaseDeDatos\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Sin paquete MSIX: se ejecuta como un .exe normal. Windows App SDK va incluido junto al .exe,
         así nadie del equipo tiene que instalarlo aparte. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- Mac Catalyst 17 = macOS 14 (Sonoma) o más nuevo, el mínimo de este SDK -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icono de la ventana y de la barra de tareas: el sol de SuraChih sobre tinta -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1B3A" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="BackendLogica\BackendLogica.csproj" />
    <ProjectReference Include="Interfaz\Interfaz.csproj" />
  </ItemGroup>

</Project>
