<?xml version="1.0" encoding="utf-8" ?>
<!--
  Única página de la app: un BlazorWebView que ocupa toda la ventana. Monta Interfaz.Rutas en #app
  (wwwroot/index.html) y HeadOutlet en <head> para los títulos de cada pantalla.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:interfaz="clr-namespace:Interfaz;assembly=Interfaz"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="SuraChihIntegrativeProject.MainPage"
             BackgroundColor="White">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                   BlazorWebViewInitialized="AlInicializarWebView">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type interfaz:Rutas}" />
            <RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
